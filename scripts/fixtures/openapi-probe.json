{
    "openapi": "3.1.2",
    "info": {
        "title": "Tesserarr API",
        "version": "1",
        "description": "The token API of Tesserarr. Every request carries an API token as a bearer token; an operation lists the permission the token needs as the scope of `apiToken`. The web interface uses its own session API, which is not part of this document."
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "This installation"
        }
    ],
    "paths": {
        "/_probe": {
            "get": {
                "operationId": "probe.show",
                "description": "Answers the name of the probe. Used by the OpenAPI tests only.",
                "summary": "Read the probe",
                "tags": [
                    "Probe"
                ],
                "responses": {
                    "200": {
                        "description": "The probe",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "examples": [
                                        {
                                            "name": "probe"
                                        }
                                    ],
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "const": "probe"
                                        }
                                    },
                                    "required": [
                                        "name"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token lacks the permission catalog.browse",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "apiToken": [
                            "catalog.browse"
                        ]
                    }
                ]
            },
            "put": {
                "operationId": "probe.update",
                "description": "Changes the name of the probe. Used by the OpenAPI tests only.",
                "summary": "Rename the probe",
                "tags": [
                    "Probe"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "The new name of the probe",
                                        "examples": [
                                            "renamed"
                                        ]
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The renamed probe",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "examples": [
                                        {
                                            "name": "renamed"
                                        }
                                    ],
                                    "properties": {
                                        "name": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "name"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "The name is missing or not a string",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Errors overview."
                                        },
                                        "errors": {
                                            "type": "object",
                                            "description": "A detailed description of each field that failed validation.",
                                            "additionalProperties": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "required": [
                                        "message",
                                        "errors"
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token lacks the permission catalog.manage",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "apiToken": [
                            "catalog.manage"
                        ]
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "apiToken": {
                "type": "http",
                "description": "An API token of a user (Settings > API tokens). The scopes of an operation name the permission the token must carry; the owner must hold it as well.",
                "scheme": "bearer"
            }
        }
    }
}
