{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "license": "AGPL-3.0-or-later",
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
        "lint": "vp lint && vp fmt --check",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@inertiajs/svelte": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/svelte": "^1.35.0",
        "@scalar/api-reference": "1.83.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "bits-ui": "^2.15.0",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "svelte": "^5.16.0",
        "svelte-sonner": "^0.3.28",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitest/coverage-v8": "5.0.5",
        "concurrently": "^10.0.3",
        "jsdom": "30.1.3",
        "playwright-core": "1.64.1",
        "svelte-check": "^4.1.4",
        "typescript": "^5.7.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0",
        "vitest": "5.0.5"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.68.8",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    }
}
