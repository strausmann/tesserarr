# Tesserarr web server (FrankenPHP = Caddy + PHP).
#
# Body limit, first stage: Caddy rejects bodies above 2 MiB with 413 and gives
# a client 10 s to send the body (against slow-body attacks). The application
# adds a second, tighter stage for /api/* and /auth/* (LimitRequestBody).
#
# https://frankenphp.dev/docs/config
# https://caddyserver.com/docs/caddyfile/options#timeouts
# https://caddyserver.com/docs/caddyfile/directives/request_body

{
	skip_install_trust
	admin off
	auto_https off

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	servers {
		timeouts {
			read_body 10s
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME::8080} {
	root /app/public

	# max_size cuts the body off at 2 MiB while it is read, but PHP does not
	# pass that read error on as a status. A declared Content-Length above the
	# limit is therefore answered here, before PHP starts.
	request_body {
		max_size 2MiB
	}

	@body_too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 2097152`
	respond @body_too_large "request body too large" 413 {
		close
	}

	# read_body cuts the body off after 10 s, but net/http then reads the rest
	# of an unread body before it writes the response, with the read deadline
	# already cleared: a client sending one byte per second would hold the
	# PHP thread until it is done. "Connection: close" makes net/http skip
	# that read and close the connection after the response.
	@has_body not method GET HEAD OPTIONS
	header @has_body Connection close

	encode zstd br gzip

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	php_server
}
