#
# Base images of docker/Dockerfile, pinned by tag and digest. This file is the
# only place they are pinned: the Dockerfile declares them as ARG without a
# default, and every build passes these lines as build arguments
# (scripts/base_images.py). Renovate updates the tag and the digest here; the
# file has no code owner, so such an update merges after green CI.
#
# One NAME_IMAGE=repository:tag@sha256:<digest> per line, no quotes, no spaces.
FRANKENPHP_IMAGE=dunglas/frankenphp:1.14.0-php8.5-trixie@sha256:b8e0919047838ea32771ef573d74df9a9128de1e908a999366e26c11bc6e7ba4
COMPOSER_IMAGE=composer:2.11.3@sha256:4e5f671c4a5784b422c20fcb993a38da96529438889dbce40be27c452d18dd6d
NODE_IMAGE=node:26.13.1-bookworm-slim@sha256:0042e17d232a87a2cd485be1da7900fca4d10a4ad11b29e9285da1d2e54798c9
