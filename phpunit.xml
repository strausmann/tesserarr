<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="PHPStan">
            <directory>tests/PHPStan</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The rule tests in tests/PHPStan run PHPStan in-process over the Laravel classes. -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!-- Real driver with test keys: the null broadcaster authorises every channel (Spec 17). -->
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="REVERB_APP_ID" value="tesserarr-test"/>
        <env name="REVERB_APP_KEY" value="tesserarr-test-key"/>
        <env name="REVERB_APP_SECRET" value="tesserarr-test-secret"/>
        <env name="REVERB_HOST" value="127.0.0.1"/>
        <env name="REVERB_PORT" value="8081"/>
        <env name="REVERB_SCHEME" value="http"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Keep the per-request access log out of the test output. -->
        <env name="TESSERARR_ACCESS_LOG" value="php://memory"/>
        <!-- PostgreSQL in tests as in production; no SQLite. Host and credentials can be overridden by the environment. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="tesserarr_test"/>
        <env name="DB_USERNAME" value="tesserarr"/>
        <env name="DB_PASSWORD" value="tesserarr"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
