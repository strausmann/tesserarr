includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # Worker-safe code (CONTRIBUTING.md): own rules and disallowed calls.
    - tests/PHPStan/worker-safety.neon
    # One authorisation function, no account looked up by address.
    - tests/PHPStan/authorization.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - scripts/
        # The worker-safety rules and their tests, not the fixtures, which break
        # the rules on purpose.
        - tests/PHPStan/Rules/

    level: 8
